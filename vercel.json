{
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "patrimovel.vercel.app"
        }
      ],
      "destination": "https://patrimoveladm.com.br/$1",
      "permanent": true
    },
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "imoveis.patrimoveladm.com.br"
        }
      ],
      "destination": "https://patrimoveladm.com.br/$1",
      "permanent": true
    },
    {
      "source": "/imovel/:tipo/:negocio/:cidade/:uf/:bairro/:codigo",
      "destination": "/imovel/:codigo",
      "permanent": true
    },
    {
      "source": "/fale-conosco",
      "destination": "/contato",
      "permanent": true
    },
    {
      "source": "/cadastre-seu-imovel",
      "destination": "/anunciar",
      "permanent": true
    },
    {
      "source": "/anunciar-imovel",
      "destination": "/anunciar",
      "permanent": true
    },
    {
      "source": "/conheca/:resto*",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/blog/tags/:tag*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-feed.xml",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|img/|data/|assets/|favicon|apple-touch).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
