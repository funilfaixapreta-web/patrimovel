{
  "redirects": [
    {
      "source": "/imovel/:tipo/:negocio/:cidade/:uf/:bairro/:codigo",
      "destination": "/imovel/:codigo",
      "permanent": true
    },
    {
      "source": "/fale-conosco",
      "destination": "/contato",
      "permanent": true
    },
    {
      "source": "/cadastre-seu-imovel",
      "destination": "/anunciar",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/bairros",
      "permanent": false
    },
    {
      "source": "/anunciar-imovel",
      "destination": "/anunciar",
      "permanent": true
    },
    {
      "source": "/conheca/:resto*",
      "destination": "/sobre",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!img/|data/|assets/|favicon|apple-touch).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
